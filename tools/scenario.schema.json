{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "phase", "entry", "restore", "deterministic", "checks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][0-9]{2}[a-z]?$" },
    "name": { "type": "string" },
    "phase": { "type": "integer", "minimum": 1, "maximum": 3 },
    "area": { "type": "string" },
    "entry": { "type": "string" },
    "assets": { "type": "string" },
    "lock": { "type": "string" },
    "restore": {
      "type": "object",
      "required": ["mode", "expectSuccess"],
      "properties": {
        "mode": { "enum": ["locked", "generate", "offline"] },
        "expectSuccess": { "type": "boolean" },
        "expectedCodes": { "type": "array", "items": { "type": "string" } },
        "arguments": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deterministic": { "type": "boolean" },
    "nightly": { "type": "boolean" },
    "checks": { "type": "array", "items": { "type": "string" } },
    "vulnerabilityPackages": { "type": "array", "items": { "type": "string" } }
  }
}
