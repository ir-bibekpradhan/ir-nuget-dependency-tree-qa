<configuration>
  <packageSources><clear /><add key="local" value="feed" /><add key="duplicate" value="duplicate-feed" /></packageSources>
  <packageSourceMapping><clear /><packageSource key="local"><package pattern="IR.QA.*" /></packageSource><packageSource key="duplicate"><package pattern="Never.Match.*" /></packageSource></packageSourceMapping>
</configuration>
