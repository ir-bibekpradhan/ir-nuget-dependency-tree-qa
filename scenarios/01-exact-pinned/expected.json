{
  "description": "Exact PackageReference resolves to one pinned leaf node",
  "project": "ExactPinned.csproj",
  "targets": {
    "net8.0": {
      "packages": {
        "Newtonsoft.Json": { "version": "13.0.3", "direct": true }
      },
      "edges": [["$root", "Newtonsoft.Json"]],
      "minPackages": 1,
      "minDepth": 1
    }
  }
}
