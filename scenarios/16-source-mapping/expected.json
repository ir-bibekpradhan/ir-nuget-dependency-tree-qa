{
  "description": "Package source mapping retains the same resolved identity",
  "project": "SourceMapping.csproj",
  "restoreArgs": ["--configfile", "NuGet.Config", "--use-lock-file", "--force-evaluate"],
  "targets": {
    "net8.0": {
      "packages": { "Newtonsoft.Json": { "version": "13.0.3", "direct": true } },
      "edges": [["$root", "Newtonsoft.Json"]]
    }
  }
}
