{
  "description": "Unbracketed version is a minimum and resolves by NuGet rules",
  "project": "MinimumVersion.csproj",
  "targets": {
    "net8.0": {
      "packages": {
        "Newtonsoft.Json": { "version": "12.0.3", "direct": true }
      },
      "edges": [["$root", "Newtonsoft.Json"]],
      "minPackages": 1
    }
  }
}
